# Copy to .env.local (Windows: Copy-Item .env.example .env.local) and fill in.
# NEXT_PUBLIC_* values are embedded in the browser bundle. Firebase web config is designed to be
# public — security comes from firestore.rules — but never put secret/server keys in NEXT_PUBLIC_*.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://launchlayer.me
NEXT_PUBLIC_CONTACT_EMAIL=workmailkartikeya@gmail.com
NEXT_PUBLIC_GRIEVANCE_OFFICER=Kartikeya Mishra

# --- Firebase (Console → Project settings → Your apps → Web app) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Analytics & search verification (optional) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- Google AdSense (leave empty until approved; ads render nowhere until set) ---
# Publisher id, e.g. ca-pub-1234567890123456  (also generates /ads.txt automatically)
NEXT_PUBLIC_ADSENSE_CLIENT=
# Ad unit slot ids (AdSense → Ads → By ad unit → Display ad, responsive)
NEXT_PUBLIC_ADSENSE_SLOT_TOOL=
NEXT_PUBLIC_ADSENSE_SLOT_TASK=

# --- Apps (leave empty to show "Coming soon") ---
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=

# --- Future payments (not used yet) ---
# NEXT_PUBLIC_PAYPAL_LINK=

# --- Legal identity (change when you incorporate) ---
NEXT_PUBLIC_LEGAL_ENTITY=Kartikeya Mishra (sole proprietor), India

# --- Telegram bot (optional, SERVER-ONLY: never prefix with NEXT_PUBLIC_) ---
# Create a bot with @BotFather, then run `npm run telegram:setup` after deploying.
TELEGRAM_BOT_TOKEN=
# 16–256 random chars (A-Z a-z 0-9 _ -). Telegram sends it with every webhook call.
TELEGRAM_WEBHOOK_SECRET=
